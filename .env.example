# Supabase (public anon key — safe for the browser only if RLS policies are in place)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PIN de recepción (temporal; ver docs/PLAN-LOGICA.md para el modelo de sesión definitivo)
VITE_RECEPTION_PIN=

# Usuarios con rol admin (separados por coma) hasta que exista la columna role en doctors
VITE_ADMIN_USERNAMES=miguel sandoval

# Proxy de IA (Supabase Edge Function). Si está vacío, el cliente usa las llaves VITE_* directas (solo desarrollo).
VITE_AI_PROXY_URL=

# SOLO DESARROLLO LOCAL. Nunca desplegar con estas llaves en el bundle: cualquiera con la tablet puede extraerlas.
VITE_OPENAI_API_KEY=
VITE_PERPLEXITY_API_KEY=

# Tras cambiar cualquier llave: reinicie "npm run dev" (Vite solo lee .env al arrancar)
# y verifique con "npm run check:ai" o en Administración > Probar conexiones.
